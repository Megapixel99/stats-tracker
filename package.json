{
  "name": "tallyboard",
  "version": "2.1.0",
  "description": "Report process, traffic, database and job stats from Node apps to a shared dashboard",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./tracker": "./lib/tracker.js",
    "./dashboard": "./lib/dashboard.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "database/",
    "functions/",
    "routers/",
    "views/",
    "public/assets/"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dashboard": "node ./dashboard.js",
    "demo": "node ./demo/demo.js",
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Megapixel99/tallyboard.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Megapixel99/tallyboard/issues"
  },
  "homepage": "https://github.com/Megapixel99/tallyboard#readme",
  "devDependencies": {
    "dotenv": "^17.2.3",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express4": "npm:express@^4.22.3",
    "luxon": "^3.7.2",
    "mongoose": "^9.11.4"
  }
}
